{
  "name": "hop.top",
  "build": {
    "dockerfile": "Dockerfile",
    "context": ".."
  },
  "forwardPorts": [4321],
  "portsAttributes": {
    "4321": {
      "label": "hop.top site",
      "onAutoForward": "openPreview"
    }
  },
  "customizations": {
    "vscode": {
      "settings": {
        "devbox.autoShellOnTerminal": true
      },
      "extensions": [
        "jetpack-io.devbox",
        "dbaeumer.vscode-eslint",
        "tamasfe.even-better-toml",
        "redhat.vscode-yaml"
      ]
    }
  },
  "postCreateCommand": "devbox run -- make post-create",
  "postStartCommand": "devbox run -- make dev-start",
  "remoteUser": "vscode"
}
