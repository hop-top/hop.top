{
  "name": "@hop-top/workspace",
  "version": "0.0.0",
  "description": "Ecosystem hub — marketing site, edge router, Go vanity imports",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "npm --prefix apps/cli run build",
    "lint": "eslint apps/cli/src/",
    "format": "prettier --write apps/cli/src/",
    "test": "vitest run",
    "test:e2e": "vitest run --config tests/e2e/vitest.config.ts",
    "check": "npm run lint && npm run test"
  },
  "author": "Jad Bitar <jadb@users.noreply.github.com>",
  "license": "Apache-2.0",
  "devDependencies": {
    "@types/node": "^25.6.0",
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "@typescript-eslint/parser": "^8.0.0",
    "eslint": "^9.0.0",
    "prettier": "^3.0.0",
    "typescript": "^5.6.0",
    "vitest": "2.1.9",
    "yaml": "2.8.3"
  }
}
