---
import Base from '../layouts/Base.astro';
import { projects, categories } from '../data/projects';

export function getStaticPaths() {
  return projects.map((p) => ({
    params: { pkg: p.name },
    props: { project: p },
  }));
}

const { project } = Astro.props;
const cat = categories[project.category];
---

<Base
  title={`${project.name} — hop.top`}
  description={project.description}
>
  <main class="pkg-page">
    <div class="pkg-glow"></div>
    <div class="pkg-content">
      <a href="/" class="pkg-back">&larr; all packages</a>

      <div class="pkg-header">
        <h1 class="pkg-title">
          <span class="pkg-path">hop.top/</span>{project.name}
        </h1>
        <span
          class="pkg-badge"
          style={`--badge-color: ${cat.color}`}
        >
          {cat.label}
        </span>
      </div>

      <p class="pkg-desc">{project.description}</p>

      {
        project.install && (
          <div class="pkg-install-block">
            <span class="pkg-install-label">Install</span>
            <pre class="pkg-install-cmd"><code>{project.install}</code></pre>
          </div>
        )
      }

      <div class="pkg-links">
        <a href={project.repo} class="pkg-link">
          <svg
            width="20"
            height="20"
            viewBox="0 0 16 16"
            fill="currentColor"
          >
            <path
              d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53
              5.47 7.59.4.07.55-.17.55-.38
              0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94
              -.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53
              .63-.01 1.08.58 1.23.82.72 1.21 1.87.87
              2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95
              0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12
              0 0 .67-.21 2.2.82.64-.18 1.32-.27
              2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82
              2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82
              1.27.82 2.15 0 3.07-1.87 3.75-3.65
              3.95.29.25.54.73.54 1.48 0 1.07-.01
              1.93-.01 2.2 0 .21.15.46.55.38A8.01 8.01
              0 0016 8c0-4.42-3.58-8-8-8z"
            ></path>
          </svg>
          Source on GitHub
        </a>
        <a
          href={`https://pkg.go.dev/hop.top/${project.name}`}
          class="pkg-link"
        >
          Docs
        </a>
      </div>
    </div>
  </main>
</Base>

<style>
  .pkg-page {
    position: relative;
    max-width: 720px;
    margin: 0 auto;
    padding: 4rem 2rem;
    overflow: hidden;
  }

  .pkg-glow {
    position: absolute;
    top: -200px;
    right: -100px;
    width: 400px;
    height: 400px;
    background: radial-gradient(
      circle,
      color-mix(in srgb, var(--accent-amber) 10%, transparent),
      transparent 70%
    );
    pointer-events: none;
  }

  .pkg-content {
    position: relative;
    z-index: 1;
  }

  .pkg-back {
    display: inline-block;
    color: var(--text-muted);
    font-size: 0.875rem;
    margin-bottom: 2rem;
    transition: color 0.15s;
  }

  .pkg-back:hover {
    color: var(--text-secondary);
  }

  .pkg-header {
    display: flex;
    align-items: center;
    gap: 1rem;
    flex-wrap: wrap;
    margin-bottom: 1rem;
  }

  .pkg-title {
    font-family: var(--font-mono);
    font-size: clamp(1.75rem, 4vw, 2.5rem);
    font-weight: 700;
    letter-spacing: -0.03em;
    color: var(--text-primary);
  }

  .pkg-path {
    color: var(--text-muted);
  }

  .pkg-badge {
    font-size: 0.6875rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--badge-color);
    background: color-mix(
      in srgb,
      var(--badge-color) 12%,
      transparent
    );
    padding: 0.25em 0.6em;
    border-radius: 4px;
  }

  .pkg-desc {
    font-size: 1.125rem;
    color: var(--text-secondary);
    line-height: 1.6;
    margin-bottom: 2rem;
  }

  .pkg-install-block {
    background: var(--bg-surface);
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    padding: 1.25rem 1.5rem;
    margin-bottom: 2rem;
  }

  .pkg-install-label {
    display: block;
    font-size: 0.6875rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--text-muted);
    margin-bottom: 0.5rem;
  }

  .pkg-install-cmd {
    font-family: var(--font-mono);
    font-size: 0.9375rem;
    color: var(--accent-amber);
    background: none;
    overflow-x: auto;
  }

  .pkg-links {
    display: flex;
    gap: 1rem;
    flex-wrap: wrap;
  }

  .pkg-link {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.5rem 1.25rem;
    border: 1px solid var(--border);
    border-radius: var(--radius);
    color: var(--text-secondary);
    font-size: 0.875rem;
    font-weight: 500;
    transition:
      border-color 0.15s,
      color 0.15s;
  }

  .pkg-link:hover {
    border-color: var(--border-hover);
    color: var(--text-primary);
  }
</style>
